generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String
  email          String
  batch          String
  program        String
  activities     String   // We will store this as a JSON string or comma-separated
  mrMissFreshers Boolean  @default(false)
  passType       String
  amount         Int
  createdAt      DateTime @default(now())

}
